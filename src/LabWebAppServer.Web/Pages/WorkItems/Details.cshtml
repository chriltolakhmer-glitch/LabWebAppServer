@page "{id:guid}"
@model DetailsModel
@{
    ViewData["Title"] = "Work-item details";
}

<div class="py-5">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <p class="text-uppercase text-secondary small fw-semibold mb-2">Work-item</p>
            <h1 class="display-6 fw-semibold">Details</h1>
        </div>
        <a class="btn btn-outline-secondary" asp-page="/Index">Back to work-items</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert" aria-live="polite">@Model.ErrorMessage</div>
    }
    else if (Model.Item is not null)
    {
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Item.Name</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Item.Description ?? "(none)")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Item.Status</dd>
            <dt class="col-sm-3">Updated</dt>
            <dd class="col-sm-9">@Model.Item.UpdatedAtUtc.ToString("u")</dd>
            <dt class="col-sm-3">Updated by</dt>
            <dd class="col-sm-9">@Model.Item.UpdatedBy</dd>
        </dl>
    }
</div>
